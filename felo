<title>v3D Studio - コンテナ蓄電システム設計</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Meiryo, sans-serif; background: #1a1a2e; color: #e0e0e0; overflow: hidden; height: 100vh; }
  #app { display: flex; height: 100vh; }
  #sidebar { width: 340px; background: #24243a; padding: 12px; overflow-y: auto; border-right: 2px solid #3a3a5a; flex-shrink: 0; }
  #sidebar h2 { font-size: 16px; margin-bottom: 8px; color: #8ab4ff; }
  #sidebar h3 { font-size: 13px; margin: 8px 0 4px; color: #ffd700; cursor: pointer; user-select: none; }
  #sidebar h3:hover { color: #ffe44d; }
  .section { border: 1px solid #3a3a5a; border-radius: 6px; padding: 8px; margin-bottom: 8px; background: #2a2a44; }
  .section.collapsed .inputs { display: none; }
  .inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 6px; }
  .inputs label { font-size: 11px; color: #aaa; display: flex; flex-direction: column; }
  .inputs input[type="number"], .inputs input[type="color"], .inputs input[type="range"] { width: 100%; background: #1a1a2e; border: 1px solid #555; color: #fff; border-radius: 4px; padding: 3px 4px; font-size: 12px; }
  .inputs input[type="color"] { padding: 1px; height: 28px; }
  .full { grid-column: 1 / -1; }
  .btn-group { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .btn { background: #3a5a8a; color: #fff; border: none; padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; }
  .btn:hover { background: #4a7a9a; }
  .btn-danger { background: #a33; }
  .btn-danger:hover { background: #c44; }
  #canvas-container { flex: 1; position: relative; }
  #canvas-container canvas { display: block; width: 100%; height: 100%; }
  #overlay-top-right { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.7); padding: 8px 12px; border-radius: 6px; font-size: 12px; color: #fff; pointer-events: none; z-index: 10; }
  #overlay-bottom { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.7); padding: 8px 16px; border-radius: 6px; font-size: 12px; color: #fff; display: flex; gap: 20px; pointer-events: none; z-index:  ​10; white-space: nowrap; }
  #toolbar { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index:: 10; }
  #toolbar .btn { background: #2a4a6a; }
  .drag-hint { position: absolute; bottom: 50px; left:  ​50%; transform: translateX(-50%); color: #aaa; font-size:: 12px; background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px; pointer-events: none; z-index:: 10; }
  .status { font-size: 11px; color: #8f8; margin-top: 4px; }
  .weight-summary { font-size: 12px; color: #ffd700; margin-top: 8px; padding: 6px; background: #2a2a44; border-radius: 4px; }
  .weight-summary div { margin: 2px 0; }
  .collapsible-header { display: flex; justify-content: space-between; align-items: center; }
  .collapsible-header .arrow { font-size: 10px; }
  .section.collapsed .arrow { transform: rotate(-90deg); }
  .section .arrow { transition: transform 0.2s; }
  .color-row { display: flex; align-items: center; gap: 6px; }
  .color-row label { flex: 1; }
  .color-row input[type="color"] { width: 40px; flex-shrink: 0; }
  .opacity-row { display: flex; align-items: center; gap:  ​6px; }
  .opacity-row label { flex: 1; }
  .opacity-row input[type="range"] { flex:  ​2; }
  .opacity-row span { width: 40px; text-align: right; font-size: 11px; }
  .note { font-size: 10px; color: #888; margin-top: 4px; }
  .btn-group .btn { flex:  ​1; text-align: center; }
  .btn-group .btn.wide { flex-basis: 100%; }
  .btn-group .btn.small { flex:  ​0 0 auto; padding: 4px 8px; font-size: 11px; }
